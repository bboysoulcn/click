



# 创建 FastAPI 应用
app = FastAPI(
    title="Click - 点赞按钮 API",
    description="注重隐私的页面点击计数和点赞按钮系统",
    version="1.0.0",
    docs_url="/docs" if settings.debug else None,
    redoc_url="/redoc" if settings.debug else None,
)

# 配置 CORS
app.add_middleware(
    CORSMiddleware,
    allow_origins=settings.origins_list,
    allow_credentials=True,
    allow_methods=["GET", "POST"],
    allow_headers=["*"],
)


# 启动事件
@app.on_event("startup")
async def startup_event():
    """启动时初始化服务"""
    logger.info("正在启动 Click API 服务器...")
    logger.info("速率限制已启用（内存 + 数据库）")


# 关闭事件
@app.on_event("shutdown")
async def shutdown_event():
    """关闭时清理资源"""
    logger.info("正在关闭 Click API 服务器...")


# 包含路由
app.include_router(router)

# 挂载静态文件
static_dir = os.path.join(os.path.dirname(__file__), "..", "static")
if os.path.exists(static_dir):
    app.mount("/static", StaticFiles(directory=static_dir), name="static")
    logger.info(f"静态文件已从 {static_dir} 挂载")


# 根路径
@app.get("/")
async def root():
    """根接口"""
    return {
        "message": "Click - 点赞按钮 API",
        "version": "1.0.0",
        "docs": "/docs" if settings.debug else "已禁用",
        "demo": "/static/index.html"
    }


if __name__ == "__main__":
    import uvicorn
    uvicorn.run(
        "app.main:app",
        host=settings.host,
        port=settings.port,
        reload=settings.debug
    )
